# SEO оптимизация для КЖУП "Буда-Кошелёвский коммунальник"

# Корень отдаём через seo.php (server-side meta), иначе — статический каркас.
DirectoryIndex seo.php index.html

# Включаем mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Принудительное использование HTTPS (если есть SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Принудительное использование www (или без www)
    # RewriteCond %{HTTP_HOST} !^www\. [NC]
    # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [L,R=301]

    # -----------------------------------------------------------------
    # ЗАЩИТА: Отсекаем левые PHP и выдаем хостингу честный 404 статус
    # -----------------------------------------------------------------
    
    # Если запрашивают ЛЮБОЙ .php файл, КРОМЕ рабочего backend/api.php и
    # seo.php (server-side meta), отдаем сухую системную ошибку 404
    RewriteCond %{REQUEST_URI} !^/backend/api\.php [NC]
    RewriteCond %{REQUEST_URI} !^/seo\.php [NC]
    RewriteCond %{REQUEST_URI} \.php$ [NC]
    RewriteRule ^ - [R=404,L]

    # -----------------------------------------------------------------
    # СТАНДАРТНЫЙ РОУТИНГ ДЛЯ REACT SPA (БЕЗ РЕДИРЕКТОВ)
    # -----------------------------------------------------------------

    # Реальный файл (картинка, js, css) — отдаём как есть.
    # Остальные маршруты уходят в seo.php: он подставляет мета в каркас
    # index.html и отдаёт готовый HTML (важно для краулеров и соцсетей).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/backend/ [NC]
    RewriteRule . /seo.php [L]

</IfModule>

# -----------------------------------------------------------------
# КРАСИВАЯ 404 СТРАНИЦА ДЛЯ ПОЛЬЗОВАТЕЛЕЙ
# -----------------------------------------------------------------
# Если папка или файл не найдены, сервер отдаст index.html с кодом 404.
# Браузер загрузит React, и ваш внутренний роутер покажет красивую 404.
ErrorDocument 404 /index.html


# Кэширование статических ресурсов
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Изображения
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    
    # CSS и JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # Шрифты
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    
    # HTML
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Сжатие Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Настройки безопасности
<IfModule mod_headers.c>
    # Защита от XSS
    Header set X-XSS-Protection "1; mode=block"
    
    # Защита от clickjacking
    Header always append X-Frame-Options SAMEORIGIN
    
    # Защита от MIME-сниффинга
    Header set X-Content-Type-Options nosniff
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Запрет доступа к служебным файлам
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>