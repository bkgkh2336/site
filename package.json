{
  "name": "jkx",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run php\" \"vite\"",
    "php": "php -S localhost:8000",
    "php:router": "php -S localhost:8000 router.php",
    "dev:full": "concurrently \"npm run php:router\" \"vite\"",
    "vite": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "install:backend": "cd backend && npm install",
    "install:all": "npm install && npm run install:backend",
    "start:backend": "cd backend && npm start",
    "postinstall": "npm run install:backend",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "build": "npm run generate:sitemap && vite build",
    "organize-public": "node scripts/organize-public.js",
    "prepare-deploy": "npm run build && shx mkdir -p dist/backend && shx cp backend/.env dist/backend/ && shx cp backend/.htaccess dist/backend/ && shx cp backend/api.php dist/backend/ && shx cp .htaccess dist/",
    "prepare-deploy:first": "npm run prepare-deploy && shx cp backend/contacts.db dist/backend/"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "lucide-react": "^0.561.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.9.6",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-world-flags": "^1.6.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "shx": "^0.4.0",
    "terser": "^5.44.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vite-bundle-visualizer": "^1.2.1"
  },
  "description": "This template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.",
  "main": "eslint.config.js",
  "keywords": [],
  "author": "Tunwell1",
  "license": "ISC"
}
