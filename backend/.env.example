# Copy this file to .env and fill in your values

# Session secret key for HMAC-signed admin session tokens.
# Generate a strong random string, e.g.: php -r "echo bin2hex(random_bytes(32));"
SESSION_SECRET=

# Admin password hash for /api/login (bcrypt).
# Generate: php generate_hash.php "your_password"  ->  put the $2y$... hash here.
# Without this (or SESSION_SECRET) login returns 500 — the site stays public,
# but the admin panel cannot authenticate.
ADMIN_PASSWORD_HASH=

# Session expiry time in seconds (default: 7 days; empty or invalid value -> 7 days)
SESSION_EXPIRY=604800

# Reserved for future use: backend/api.php does not read this value yet.
APP_ENV=production
