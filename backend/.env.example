# Backend Environment Variables
# Copy this file to .env and fill in your values

# Session secret key for JWT tokens (generate a strong random string)
SESSION_SECRET=your-super-secret-session-key-change-this-2026

# Session expiry time in seconds (default: 1 hour)
SESSION_EXPIRY=3600

# Admin password hash (generate using: php generate_hash.php "your_password")
# PASSWORD_HASH=

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Environment (development/production)
APP_ENV=development
